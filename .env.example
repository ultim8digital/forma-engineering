# Optional process environment. The application does not load this file automatically.
# Prefix npm start with these variables, or export them in your terminal.
FORMA_PORT=5173
# Default: forma-data/ inside the checkout. Use an absolute path to override it.
# FORMA_DATA_DIR=/absolute/path/to/forma-data
# Absolute path to Python with worker-node/requirements.txt installed.
# FORMA_PYTHON=/absolute/path/to/python
# MCP bridge only: set this when using a different server port.
# FORMA_URL=http://127.0.0.1:5173
# Optional UI-created revocable token for the MCP bridge.
# FORMA_AGENT_TOKEN=
# API and model settings are configured in the local UI, not in this file.
