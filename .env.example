# Compute node / MCP bridge; never commit real values.
FORMA_URL=http://localhost:5173
FORMA_WORKER_TOKEN=replace-with-a-random-secret
# Private Sites service-access token. Obtain from Sites settings; never use account cookies.
FORMA_SITES_TOKEN=
# Optional compatible API, e.g. http://127.0.0.1:1234/v1
FORMA_LLM_BASE_URL=
FORMA_LLM_API_KEY=
FORMA_LLM_MODEL=
# Optional least-privilege agent token from the UI.
FORMA_AGENT_TOKEN=
