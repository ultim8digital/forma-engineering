{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "client",
    "components/Studio.tsx",
    "components/EngineeringPanel.tsx",
    "components/ProviderSettings.tsx",
    "components/Viewport.tsx",
    "lib/contracts.ts",
    "lib/engineering.ts",
    "server",
    "vite.config.ts",
    "vite.server.config.ts"
  ]
}
