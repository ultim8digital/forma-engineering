{
  "name": "neofab-studio",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "setup:claude": "npm --prefix worker-node/js ci",
    "dev": "npm run build:server && node dist/server/index.js --dev",
    "build:server": "vite build --config vite.server.config.ts",
    "build": "vite build && npm run build:server",
    "start": "node scripts/start-local.mjs",
    "test:local": "node --test tests/local.test.mjs",
    "test:cad": ".venv/bin/python -m pytest tests/test_cad.py -q",
    "test:engineering": ".venv/bin/python -m pytest tests/test_cad.py tests/test_engineering.py tests/test_providers.py -q",
    "mcp": ".venv/bin/python worker-node/mcp_server.py",
    "test:editor": "node --test tests/editor.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "@types/three": "^0.186.0"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultim8digital/neofab.git"
  },
  "bugs": {
    "url": "https://github.com/ultim8digital/neofab/issues"
  }
}
